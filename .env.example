# ==============================================================================
# StructuredAI - Configuration du Framework d'Orchestration Autonome
# ==============================================================================
# Copiez ce fichier vers `.env` et adaptez les variables à votre machine,
# votre modèle IA léger, votre durée d'exécution et votre projet cible.

# ------------------------------------------------------------------------------
# 1. PROJET CIBLE & MODE D'EXÉCUTION
# ------------------------------------------------------------------------------
# Chemin absolu du dossier où l'agent autonome crée/modifie fichiers et dossiers
TARGET_PROJECT_DIR=/home/gamo/Documents/structuredAI/projet

# Mode : auto (détecte si le dossier est vide ou déjà peuplé), greenfield, brownfield
PROJECT_MODE=auto

# Chemin vers la spécification initiale (absolu ou relatif à TARGET_PROJECT_DIR)
INITIAL_SPEC_PATH=SPEC.md

# Stockage des métadonnées d'orchestration :
# - shadow : isolé dans TARGET_PROJECT_DIR/ORCHESTRATOR_STATE_DIR (recommandé)
# - inline : écrit CONTRACT.md / REALITY.md directement dans les sous-dossiers
METADATA_STORAGE=shadow
ORCHESTRATOR_STATE_DIR=.orchestrator

# ------------------------------------------------------------------------------
# 2. MOTEUR TEMPOREL (TIME-BOXED ENGINE MULTI-JOURS)
# ------------------------------------------------------------------------------
# Durée totale d'exécution autonome autorisée (ex: 30m, 4h, 24h, 72h, 7d)
RUN_DURATION=24h

# Comptabilisation du temps :
# - active     : compte uniquement le temps de travail actif (immunisé veille/NTP)
# - wall_clock : arrêt strict à l'heure calendaire start + RUN_DURATION
TIME_ACCOUNTING_MODE=active

# Profil de répartition des phases : balanced | sprint | hardening
TIME_PROFILE=balanced

# Part du temps final réservée au gel, stabilisation et rapport (0.05 = 5%)
FREEZE_WINDOW_RATIO=0.05

# Budget temps maximal accordé à un seul nœud avant bascule (0.10 = 10%)
NODE_TIME_CAP_RATIO=0.10

# Plafond de cycles consécutifs sans gain en 7_HARDENING avant mise en veille/gel propre
MAX_IDLE_HARDENING_CYCLES=10

# Fréquence du heartbeat & contrôle mémoire/disque/thermique (secondes)
HEARTBEAT_INTERVAL_SEC=30

# Reprise après arrêt/crash : auto (reprend state.json), fresh (réinitialise), strict
RESUME_MODE=auto

# ------------------------------------------------------------------------------
# 3. CHOIX DE L'IA & BACKEND D'INFÉRENCE
# ------------------------------------------------------------------------------
# Backend : llama_cpp | ollama | openai_compat
LLM_PROVIDER=llama_cpp

# URL du serveur d'inférence (port dédié 18080 pour éviter collision avec apps 8080)
LLM_BASE_URL=http://127.0.0.1:18080/v1

# Clé API (laisser vide pour llama-server ou Ollama local ; strippée des tests)
LLM_API_KEY=

# Identifiant du modèle utilisé par le backend
LLM_MODEL=qwen3.5-0.8b-q4_k_m

# Dépôt Hugging Face et quantification pour téléchargement auto dans install.sh
LLM_HF_REPO=bartowski/Qwen_Qwen3.5-0.8B-GGUF
LLM_HF_QUANT=Q4_K_M

# Chemin local du fichier GGUF & binaire llama-server (auto-configurés par install.sh)
LLM_MODEL_PATH=${HOME}/.local/share/structuredai/models/Qwen3.5-0.8B-Q4_K_M.gguf
LLAMA_SERVER_BIN=llama-server
LLM_AUTO_START_SERVER=true

# Paramètres d'inférence stricts pour petits modèles
LLM_CTX_SIZE=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_DISABLE_THINKING=true

# Mode de contrainte structurelle : gbnf | json_schema | json_object | delimited
LLM_STRUCTURED_MODE=gbnf

# Modèle optionnel dédié à la Passe 2 (Critique). Vide = utilise LLM_MODEL
LLM_CRITIQUE_MODEL=

# Timeout maximal par requête LLM (secondes) & débit minimal toléré (tok/s)
LLM_TIMEOUT_SEC=90
MIN_LLM_TOKENS_PER_SEC=5

# ------------------------------------------------------------------------------
# 4. CONTRAINTES MATÉRIELLES, RAM & DISQUE (<= 1 Go PAR DÉFAUT)
# ------------------------------------------------------------------------------
# Plafond RAM total alloué à la stack IA + orchestrateur (Mo)
RAM_LIMIT_MB=1024

# Seuil RSS déclenchant un redémarrage gracieux de llama-server (Mo)
LLAMA_RSS_RESTART_MB=880

# Quantification du cache KV pour llama-server (q8_0 recommandé pour <= 1 Go)
LLAMA_KV_CACHE_TYPE=q8_0

# Nombre de threads CPU (cibler uniquement les cœurs physiques P-cores)
CPU_THREADS=4

# Timeout maximal de chaque commande de lint/build/test (secondes)
SUBPROCESS_TIMEOUT_SEC=45

# Pause de sécurité si la température CPU dépasse ce seuil (°C, 0 = désactivé)
THERMAL_PAUSE_C=85

# Délai de respiration CPU entre deux appels LLM (millisecondes)
COOLDOWN_MS=100

# Hygiène disque multi-jours (arrêt/nettoyage préventif si disque plein)
DISK_MIN_FREE_MB=2048
MAX_EVENTS_LOG_MB=50

# ------------------------------------------------------------------------------
# 5. STACK TECHNOLOGIQUE, DÉPENDANCES & INVARIANTS CODE
# ------------------------------------------------------------------------------
# Stack : auto | python | node_ts | rust | go | c_cpp | java | web_static | custom
TARGET_STACK=auto

# Chemin optionnel vers un fichier déclaratif stack.toml personnalisé
STACK_PROFILE_PATH=

# Politique d'installation de paquets tiers : none | manifest_only | allow_verified
DEPENDENCY_INSTALL_POLICY=manifest_only

# Invariants de modularité (règle des 100 lignes + anti-explosion d'arborescence)
MAX_LINES_PER_FILE=100
MIN_SPLIT_FILE_LINES=15
MAX_FILES_PER_DIR=5
MAX_TREE_DEPTH=4

# Extensions exemptées du plafond strict de 100 lignes & seuil d'ingestion max
LINE_LIMIT_EXEMPT_EXTS=.md,.json,.toml,.yaml,.yml,.lock,.sql,.css,.svg
MAX_INGEST_FILE_BYTES=262144

# Surcharges manuelles (utilisées si TARGET_STACK=custom ou pour override ponctuel)
CUSTOM_SYNTAX_CMD=
CUSTOM_LINT_CMD=
CUSTOM_TEST_CMD=
CUSTOM_BUILD_CMD=

# ------------------------------------------------------------------------------
# 6. FIABILITÉ, ANTI-RÉGRESSION, GIT & SÉCURITÉ
# ------------------------------------------------------------------------------
# Tentatives max par nœud avant passage en FAILED_MANUAL_REVIEW
MAX_RETRIES_PER_NODE=5

# Cycles max de rééquilibrage en Passe 2 (Antithèse)
MAX_REBALANCE_CYCLES=2

# Garde-fous neuro-symboliques et anti-triche activés
ENABLE_IMPORT_PREFLIGHT=true
ENABLE_ANTI_TRIVIAL_TEST_GATE=true
ENABLE_TEST_MONOTONICITY_GATE=true
ENABLE_STAGNATION_DETECTOR=true
ENABLE_DANGEROUS_CALL_SCANNER=true

# Fréquence des tests d'intégration + smoke test global (tous les N nœuds verrouillés)
INTEGRATION_CHECK_INTERVAL=5

# Isolation transactionnelle Git & rétention des tags High-Watermark
GIT_AUTO_COMMIT=true
GIT_WORK_BRANCH=ai-auto
MAX_GREEN_TAGS_KEEP=20

# Interdire l'accès réseau lors de l'exécution des tests générés (Linux unshare/sandbox)
ALLOW_NETWORK_IN_TESTS=false

# ------------------------------------------------------------------------------
# 7. OBSERVABILITÉ, AUDIT & COCKPIT ZED
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DASHBOARD_REFRESH_CYCLES=5
KEEP_ARTIFACTS_ON_FREEZE=true

# Intégration éditeur Zed (visualisation DASHBOARD.md + pilotage STEERING.md)
ZED_AUTO_OPEN=true
ZED_COMMAND=auto
ZED_SYNC_TASKS=true
